# Copy this file to .env (never commit .env). All values are optional.

# Admin dashboard backend. Leave empty to use preview mode (saved in your browser, publish by downloading videos.json).
VITE_API_BASE=

# Preview-mode admin: on = the /admin page works without a backend (it is always on while you run `npm run dev`).
VITE_ENABLE_ADMIN_PREVIEW=true
# Preview-mode passcode. This is a convenience lock only, NOT real security. Change it.
VITE_ADMIN_PASSCODE=pattern-admin

# How forms are delivered: emailjs | api | both
VITE_FORM_MODE=emailjs

# Preview-mode sign in while no backend is connected: username:password pairs separated by commas (visible in the website code, so not real security)
VITE_ADMIN_USERS=admin:pattern-admin

# The backend (see apps-script/SETUP.md): the Web app URL, and the link to your Google Sheet
VITE_API_BASE=
VITE_SHEET_URL=
